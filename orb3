#!/usr/bin/env bash
# ORB-SLAM3 oficial (EuRoC stereo + IMU), fara ROS.
# Instalare: pune acest fisier in ~/SLAM_Project/SLAM_ORB3/orb3
# Rulare:    cd ~/SLAM_Project/SLAM_ORB3 && ./orb3 MH_01_easy
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/SLAM_ORB3"
PROJECT="$(dirname "$ROOT")"
DATASETS="${ORB3_DATASETS:-$HOME/SLAM_Project/datasets/euroc}"
ARG="${1:-}"
if [[ -z "$ARG" || "$ARG" == --help || "$ARG" == -h ]]; then
  cat <<EOF
Utilizare: ./orb3 MH_01_easy
           ./orb3 MH_02_easy
           ./orb3 /cale/catre/dataset_EuRoC_ASL

Asteapta repo-ul oficial clonat direct in: $ROOT
Cauta fisiere .bag in: $DATASETS
Foloseste stereo + IMU si viewer Pangolin (fara ROS).
EOF
  exit 0
fi

if [[ ! -f "$ROOT/CMakeLists.txt" || ! -f "$ROOT/Examples/Stereo-Inertial/stereo_inertial_euroc.cc" ]]; then
  echo "EROARE: Nu gasesc sursele ORB-SLAM3 oficial in $ROOT" >&2
  echo "Cloneaza-le in acest folder: git clone https://github.com/UZ-SLAMLab/ORB_SLAM3.git ." >&2
  exit 1
fi

for cmd in cmake g++ make git python3 tar; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "EROARE: Lipseste programul $cmd. Instaleaza dependentele de compilare." >&2
    exit 1
  fi
done

if [[ -d "$ARG/mav0" ]]; then
  SEQ="$(cd "$ARG" && pwd)"
  NAME="$(basename "$SEQ")"
  BAG=""
else
  NAME="$(basename "$ARG")"
  NAME="${NAME%.bag}"
  SEQ="$DATASETS/$NAME"
  if [[ "$ARG" == *.bag && -f "$ARG" ]]; then
    BAG="$(cd "$(dirname "$ARG")" && pwd)/$(basename "$ARG")"
  else
    BAG="$DATASETS/$NAME.bag"
  fi
fi

# Pangolin este necesar pentru compilarea sursei oficiale si viewer.
# Daca exista deja in sistem, CMake il va gasi direct.
PANGO_ARGS=()
PANGO_DIR=""
for maybe in /usr/local/lib/cmake/Pangolin /usr/lib/x86_64-linux-gnu/cmake/Pangolin; do
  if [[ -f "$maybe/PangolinConfig.cmake" ]]; then
    PANGO_DIR="$maybe"
    break
  fi
done

if [[ -z "$PANGO_DIR" ]]; then
  PANGO_SRC="$ROOT/.orb3_deps/Pangolin"
  PANGO_BUILD="$PANGO_SRC/build"
  if [[ ! -d "$PANGO_SRC/.git" ]]; then
    echo "[ORB3] Pangolin nu este instalat: clonez versiunea v0.9.2 local, pentru viewer."
    mkdir -p "$ROOT/.orb3_deps"
    git clone --depth 1 --branch v0.9.2 https://github.com/stevenlovegrove/Pangolin.git "$PANGO_SRC"
  fi
  if [[ ! -f "$PANGO_BUILD/CMakeCache.txt" ]]; then
    echo "[ORB3] Configurez Pangolin ..."
    cmake -S "$PANGO_SRC" -B "$PANGO_BUILD" \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -DBUILD_EXAMPLES=OFF -DBUILD_TESTS=OFF -DBUILD_TOOLS=OFF \
      -DBUILD_PANGOLIN_PYTHON=OFF
  fi
  echo "[ORB3] Verific/compilez Pangolin ..."
  cmake --build "$PANGO_BUILD" --parallel "${ORB3_JOBS:-2}"
  PANGO_DIR="$(find "$PANGO_BUILD" -name PangolinConfig.cmake -printf '%h\n' -quit)"
  if [[ -z "$PANGO_DIR" ]]; then
    echo "EROARE: Pangolin a fost construit dar nu exista PangolinConfig.cmake." >&2
    exit 1
  fi
fi
PANGO_ARGS=("-DPangolin_DIR=$PANGO_DIR")

# Exemplar oficial EuRoC dezactiveaza Pangolin prin 'false'.
# Singura modificare automatizata a codului ORB-SLAM3 este activarea viewerului.
DEMO_SRC="$ROOT/Examples/Stereo-Inertial/stereo_inertial_euroc.cc"
if grep -q 'ORB_SLAM3::System::IMU_STEREO, false)' "$DEMO_SRC"; then
  echo "[ORB3] Activez viewerul 3D in exemplul EuRoC (backup .orb3_original)."
  cp -n "$DEMO_SRC" "$DEMO_SRC.orb3_original"
  sed -i 's/ORB_SLAM3::System::IMU_STEREO, false)/ORB_SLAM3::System::IMU_STEREO, true)/' "$DEMO_SRC"
fi

BIN="$ROOT/Examples/Stereo-Inertial/stereo_inertial_euroc"
if [[ ! -x "$BIN" ]]; then
  echo "[ORB3] Prima rulare: compilez ORB-SLAM3 (poate dura)."
  for lib in DBoW2 g2o; do
    echo "[ORB3] Construiesc Thirdparty/$lib ..."
    cmake -S "$ROOT/Thirdparty/$lib" -B "$ROOT/Thirdparty/$lib/build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    cmake --build "$ROOT/Thirdparty/$lib/build" --parallel "${ORB3_JOBS:-2}"
  done

  if [[ ! -s "$ROOT/Vocabulary/ORBvoc.txt" ]]; then
    echo "[ORB3] Dezarhivez vocabularul ORB ..."
    tar -xf "$ROOT/Vocabulary/ORBvoc.txt.tar.gz" -C "$ROOT/Vocabulary"
  fi
  cmake -S "$ROOT" -B "$ROOT/build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 "${PANGO_ARGS[@]}"
  cmake --build "$ROOT/build" --target stereo_inertial_euroc --parallel "${ORB3_JOBS:-2}"
else
  # Recompilare incrementala daca sursa viewerului tocmai a fost modificata.
  if [[ "$DEMO_SRC" -nt "$BIN" ]]; then
    echo "[ORB3] Actualizez executabilul dupa activarea viewerului ..."
    cmake -S "$ROOT" -B "$ROOT/build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 "${PANGO_ARGS[@]}"
    cmake --build "$ROOT/build" --target stereo_inertial_euroc --parallel "${ORB3_JOBS:-2}"
  fi
fi

if [[ ! -x "$BIN" ]]; then
  echo "EROARE: nu exista executabilul compilat $BIN" >&2
  exit 1
fi

if [[ ! -d "$SEQ/mav0/cam0/data" || ! -d "$SEQ/mav0/cam1/data" || ! -f "$SEQ/mav0/imu0/data.csv" ]]; then
  if [[ -z "$BAG" || ! -f "$BAG" ]]; then
    echo "EROARE: Datasetul $NAME nu exista in format ASL si nu gasesc $BAG" >&2
    echo "Pune fisierul ROS1 .bag in $DATASETS sau foloseste un director EuRoC ASL." >&2
    exit 1
  fi
  echo "[ORB3] Dataset ROS1 gasit: $BAG"
  echo "[ORB3] Formatul oficial necesita imagini PNG + imu.csv. Extrag doar datele necesare, o singura data."
  echo "[ORB3] Spatiu liber disponibil: $(df -h "$DATASETS" | awk 'NR==2 {print $4}')"

  VENV="$ROOT/.orb3_venv"
  if [[ ! -x "$VENV/bin/python" ]]; then
    python3 -m venv "$VENV" || {
      echo 'EROARE: Nu pot crea venv. Instaleaza pachetul python3-venv.' >&2
      exit 1
    }
  fi
  if ! "$VENV/bin/python" -c 'from rosbags.highlevel import AnyReader' >/dev/null 2>&1; then
    "$VENV/bin/python" -m pip install rosbags
  fi

  "$VENV/bin/python" - "$BAG" "$SEQ" <<'PYTHON'
from pathlib import Path
import csv
import struct
import sys
import zlib
from rosbags.highlevel import AnyReader

bag = Path(sys.argv[1])
seq = Path(sys.argv[2])
leftdir = seq / 'mav0' / 'cam0' / 'data'
rightdir = seq / 'mav0' / 'cam1' / 'data'
imucsv = seq / 'mav0' / 'imu0' / 'data.csv'
for d in (leftdir, rightdir, imucsv.parent):
    d.mkdir(parents=True, exist_ok=True)


def ns_stamp(header):
    stamp = header.stamp
    sec = getattr(stamp, 'sec', getattr(stamp, 'secs', None))
    nsec = getattr(stamp, 'nanosec', getattr(stamp, 'nsec', None))
    if sec is None or nsec is None:
        raise RuntimeError('Timestamp necunoscut in headerul ROS1')
    return int(sec) * 1_000_000_000 + int(nsec)


def png_chunk(name, data):
    return struct.pack('>I', len(data)) + name + data + struct.pack('>I', zlib.crc32(name + data) & 0xffffffff)


def write_mono8_png(path, msg):
    encoding = str(msg.encoding).lower()
    if encoding not in ('mono8', '8uc1'):
        raise RuntimeError(f'Camera are formatul {msg.encoding}, nu mono8; conversia trebuie adaptata.')
    width, height, step = int(msg.width), int(msg.height), int(msg.step)
    raw = memoryview(msg.data).cast('B')
    if width < 1 or height < 1 or step < width or len(raw) < step * height:
        raise RuntimeError(f'Imagine invalida: {width}x{height}, step={step}')
    # PNG grayscale 8-bit, un rand de filtrare (0) in fata fiecarei linii.
    scanlines = b''.join(b'\x00' + bytes(raw[row * step:row * step + width]) for row in range(height))
    png = (b'\x89PNG\r\n\x1a\n' + png_chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 0, 0, 0, 0))
           + png_chunk(b'IDAT', zlib.compress(scanlines, 3)) + png_chunk(b'IEND', b''))
    tmp = path.with_suffix('.png.tmp')
    tmp.write_bytes(png)
    tmp.replace(path)


def topic_kind(topic):
    topic = topic.rstrip('/')
    if topic.endswith('/cam0/image_raw'):
        return 'cam0'
    if topic.endswith('/cam1/image_raw'):
        return 'cam1'
    if topic.endswith('/imu0'):
        return 'imu0'
    return None

left, right = set(), set()
counts = dict(cam0=0, cam1=0, imu0=0)
imu_tmp = imucsv.with_suffix('.csv.tmp')
with AnyReader([bag]) as reader:
    connections = [c for c in reader.connections if topic_kind(c.topic)]
    print('[ORB3] Topicuri relevante:', [c.topic for c in connections], flush=True)
    if not {'cam0', 'cam1', 'imu0'}.issubset({topic_kind(c.topic) for c in connections}):
        raise RuntimeError('Bag-ul nu contine toate topicurile necesare: cam0, cam1, imu0')
    with imu_tmp.open('w', newline='') as handle:
        writer = csv.writer(handle)
        writer.writerow(['#timestamp [ns]', 'w_RS_S_x [rad s^-1]', 'w_RS_S_y [rad s^-1]',
                         'w_RS_S_z [rad s^-1]', 'a_RS_S_x [m s^-2]', 'a_RS_S_y [m s^-2]', 'a_RS_S_z [m s^-2]'])
        for connection, bagstamp, rawdata in reader.messages(connections=connections):
            kind = topic_kind(connection.topic)
            msg = reader.deserialize(rawdata, connection.msgtype)
            timestamp = ns_stamp(msg.header)
            if kind == 'imu0':
                writer.writerow([timestamp, msg.angular_velocity.x, msg.angular_velocity.y,
                                 msg.angular_velocity.z, msg.linear_acceleration.x,
                                 msg.linear_acceleration.y, msg.linear_acceleration.z])
            else:
                image_dir = leftdir if kind == 'cam0' else rightdir
                image_file = image_dir / f'{timestamp}.png'
                if not image_file.exists():
                    write_mono8_png(image_file, msg)
                (left if kind == 'cam0' else right).add(timestamp)
            counts[kind] += 1
            if counts['cam0'] and counts['cam0'] % 500 == 0 and kind == 'cam0':
                print(f"[ORB3] Extragere: {counts['cam0']} perechi potentiale, {counts['imu0']} masuratori IMU", flush=True)

paired = sorted(left & right)
if len(paired) < 50 or counts['imu0'] < 100:
    raise RuntimeError(f'Date insuficiente: {len(paired)} perechi stereo, {counts["imu0"]} IMU')
(seq / '.orb3_timestamps.txt').write_text(''.join(f'{ts}\n' for ts in paired))
imu_tmp.replace(imucsv)
(seq / '.orb3_extracted.done').write_text(f'{len(paired)} stereo / {counts["imu0"]} imu\n')
print(f'[ORB3] Gata: {len(paired)} perechi stereo si {counts["imu0"]} IMU', flush=True)
PYTHON
fi

# Timestamps intr-un fisier separat. Nu schimbam fisierele oficiale EuRoC.
TIMES="$SEQ/.orb3_timestamps.txt"
if [[ ! -s "$TIMES" ]]; then
  python3 - "$SEQ" "$TIMES" <<'PYTHON'
from pathlib import Path
import sys
seq, times = Path(sys.argv[1]), Path(sys.argv[2])
left = {f.stem for f in (seq / 'mav0/cam0/data').glob('*.png')}
right = {f.stem for f in (seq / 'mav0/cam1/data').glob('*.png')}
paired = sorted(left & right, key=int)
if not paired:
    sys.exit('EROARE: Nu am gasit perechi stereo cu acelasi timestamp.')
times.write_text(''.join(x + '\n' for x in paired))
print(f'[ORB3] {len(paired)} perechi stereo. Timestamps: {times}')
PYTHON
fi

OUT="$ROOT/outputs/$NAME"
mkdir -p "$OUT"
export LD_LIBRARY_PATH="$ROOT/lib:$ROOT/Thirdparty/DBoW2/lib:$ROOT/Thirdparty/g2o/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# In instalari locale Pangolin poate avea mai multe biblioteci pango_*.so
# in subdirectoare diferite. Le adaugam pe toate, in loc de o singura biblioteca.
if [[ -n "${PANGO_BUILD:-}" && -d "$PANGO_BUILD" ]]; then
  while IFS= read -r lib_dir; do
    export LD_LIBRARY_PATH="$lib_dir:$LD_LIBRARY_PATH"
  done < <(find "$PANGO_BUILD" -type f -name '*.so*' -printf '%h\n' | sort -u)
fi

echo "[ORB3] Dataset: $NAME"
echo "[ORB3] Date: $SEQ"
echo "[ORB3] Rezultate: $OUT"
echo "[ORB3] Mod: STEREO + IMU | Viewer Pangolin: ACTIV"
echo "[ORB3] Incep procesarea. Oprire: Ctrl+C"
cd "$OUT"
exec "$BIN" "$ROOT/Vocabulary/ORBvoc.txt" "$ROOT/Examples/Stereo-Inertial/EuRoC.yaml" "$SEQ" "$TIMES"
